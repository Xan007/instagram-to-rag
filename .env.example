# ==============================================================================
# InstaRAG - Environment Configuration
# ==============================================================================

# --- AI & Vector Providers (Required) ---
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
APIFY_API_KEY=your_apify_api_key_here

# --- Database Connection (Agnostic: SQLite, Supabase, Neon, AWS RDS, PostgreSQL) ---
# Default SQLite: sqlite:////data/config/instarag.db (or local ~/.instarag/instarag.db)
# PostgreSQL / Supabase / Neon: postgresql+psycopg://user:password@host:5432/dbname
# INSTARAG_DATABASE_URL=postgresql+psycopg://postgres:password@db.xxx.supabase.co:5432/postgres

# --- Server / Container Config ---
PORT=8000
INSTARAG_HOST=0.0.0.0
INSTARAG_PORT=8000

# --- Security & CORS ---
# INSTARAG_API_KEY=your_secret_api_key_here
# INSTARAG_CORS_ORIGINS=http://localhost:3000,https://myfrontend.com

# --- Optional Default User for single-tenant / CLI use ---
# INSTARAG_USER=default_user
